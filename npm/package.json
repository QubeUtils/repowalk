{
  "name": "repowalk",
  "version": "0.2.0",
  "description": "A blazing-fast, interactive CLI tool that walks your repository and packs it into a Markdown document for LLMs.",
  "main": "bin/run.js",
  "bin": {
    "repowalk": "bin/run.js"
  },
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../README.md', 'README.md')\"",
    "postinstall": "node install.js"
  },
  "keywords": [
    "llm",
    "ai",
    "context",
    "repository",
    "code",
    "markdown",
    "tui",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QubeUtils/repowalk.git"
  },
  "author": "QubeUtils",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  }
}
